---
const WA = 'https://wa.me/5212371113802?text=Hola%2C%20quiero%20cotizar%20un%20arreglo%20floral';
---

<section class="contact" id="contacto" aria-labelledby="contact-title">
  <div class="container contact__inner">
    <div class="contact__content reveal">
      <span class="contact__label">Pedidos</span>

      <h2 class="contact__title" id="contact-title">
        Cuéntanos qué quieres regalar<br />
        y lo <em>diseñamos contigo</em>
      </h2>

      <p class="contact__text">
        Mándanos la ocasión, la fecha y tu presupuesto. Te respondemos con opciones,
        fotos y el precio cerrado antes de que confirmes nada.
      </p>

      <a href={WA} class="contact__cta" target="_blank" rel="noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Escribir por WhatsApp
      </a>
    </div>

    <dl class="contact__details reveal">
      <div class="contact__row">
        <dt>Teléfono</dt>
        <dd><a href="tel:+522371113802">+52 237 111 3802</a></dd>
      </div>
      <div class="contact__row">
        <dt>Zona de entrega</dt>
        <dd>San José Buenavista · San Marcos Tlacoyalco · comunidades cercanas</dd>
      </div>
      <div class="contact__row">
        <dt>Horario</dt>
        <dd>Lun a sáb, 9:00 – 19:00<br />Domingo, 10:00 – 15:00</dd>
      </div>
      <div class="contact__row">
        <dt>Pagos</dt>
        <dd>Transferencia o efectivo. Anticipo en fechas de temporada.</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--wine-deep);
    color: #fff;
  }

  .contact__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .contact__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--brass) 70%, #fff);
    margin-bottom: 1.25rem;
  }

  .contact__label::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .contact__title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .contact__title em {
    font-style: italic;
    color: color-mix(in srgb, var(--wine-soft) 92%, transparent);
  }

  .contact__text {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
    max-width: 34rem;
    margin-bottom: 2.25rem;
    text-wrap: pretty;
  }

  .contact__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 1rem 2rem;
    border-radius: 999px;
    background: var(--cream);
    color: var(--wine-deep);
    font-size: 1rem;
    font-weight: 600;
    transition: transform var(--transition), background var(--transition);
  }

  .contact__cta:hover {
    transform: translateY(-2px);
    background: #fff;
  }

  .contact__cta:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 4px;
  }

  /* Ficha de datos: filas divididas por filetes */
  .contact__details {
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .contact__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .contact__row dt {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    padding-top: 0.15rem;
  }

  .contact__row dd {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .contact__row dd a {
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    transition: border-color var(--transition);
  }

  .contact__row dd a:hover { border-bottom-color: #fff; }

  @media (max-width: 860px) {
    .contact__inner { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .contact__row { grid-template-columns: 1fr; gap: 0.35rem; }
    .contact__cta { width: 100%; justify-content: center; }
  }
</style>
