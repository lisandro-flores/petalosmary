---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.png';

const links = [
  { href: '#galeria', label: 'Galería' },
  { href: '#catalogo', label: 'Qué hacemos' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#testimonios', label: 'Opiniones' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="navbar" id="navbar">
  <div class="container navbar__inner">
    <a href="#inicio" class="navbar__brand" aria-label="Pétalos Mary — Inicio">
      <Image src={logoImg} alt="Pétalos Mary" class="navbar__logo" loading="eager" />
    </a>

    <nav class="navbar__nav" id="navMenu" aria-label="Navegación principal">
      {links.map((link) => (
        <a href={link.href} class="navbar__link">{link.label}</a>
      ))}
      <a
        href="https://wa.me/5212371113802?text=Hola%2C%20quiero%20cotizar%20un%20arreglo%20floral"
        class="navbar__cta"
        target="_blank"
        rel="noreferrer"
      >
        Pedir ahora
      </a>
    </nav>

    <button
      class="navbar__hamburger"
      id="navHamburger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="navMenu"
    >
      <span class="navbar__hamburger-line"></span>
      <span class="navbar__hamburger-line"></span>
    </button>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1.125rem 0;
    background: color-mix(in srgb, var(--cream) 80%, transparent);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    border-bottom: 1px solid transparent;
    transition: padding var(--transition), background var(--transition),
                border-color var(--transition);
  }

  .navbar.scrolled {
    padding: 0.75rem 0;
    background: color-mix(in srgb, var(--cream) 94%, transparent);
    border-bottom-color: var(--line);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .navbar__brand {
    display: flex;
    align-items: center;
    position: relative;
    z-index: 110;
  }

  .navbar__logo {
    height: 40px;
    width: auto;
  }

  .navbar__nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .navbar__link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    position: relative;
    transition: color 220ms var(--ease);
  }

  .navbar__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 100%;
    height: 1px;
    background: var(--wine);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms var(--ease);
  }

  .navbar__link:hover { color: var(--ink); }
  .navbar__link:hover::after { transform: scaleX(1); }

  .navbar__cta {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--wine);
    padding: 0.6rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--wine) 30%, transparent);
    border-radius: 999px;
    transition: background var(--transition), color var(--transition),
                border-color var(--transition);
  }

  .navbar__cta:hover {
    background: var(--wine);
    color: #fff;
    border-color: var(--wine);
  }

  /* Hamburguesa de dos líneas */
  .navbar__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 40px;
    height: 40px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    align-items: center;
    z-index: 110;
  }

  .navbar__hamburger-line {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 340ms var(--ease);
  }

  .navbar__hamburger[aria-expanded='true'] .navbar__hamburger-line:nth-child(1) {
    transform: translateY(3.75px) rotate(45deg);
  }

  .navbar__hamburger[aria-expanded='true'] .navbar__hamburger-line:nth-child(2) {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    .navbar__hamburger { display: flex; }

    .navbar__nav {
      position: fixed;
      inset: 0;
      background: var(--cream);
      flex-direction: column;
      justify-content: center;
      gap: 0.25rem;
      z-index: 105;
      opacity: 0;
      visibility: hidden;
      transition: opacity 320ms var(--ease), visibility 320ms var(--ease);
    }

    .navbar__nav.open { opacity: 1; visibility: visible; }

    .navbar__link {
      font-size: 1.25rem;
      font-weight: 500;
      color: var(--ink);
      padding: 0.5rem 0;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 300ms var(--ease), transform 300ms var(--ease);
    }

    .navbar__nav.open .navbar__link { opacity: 1; transform: none; }
    .navbar__nav.open .navbar__link:nth-child(1) { transition-delay: 60ms; }
    .navbar__nav.open .navbar__link:nth-child(2) { transition-delay: 100ms; }
    .navbar__nav.open .navbar__link:nth-child(3) { transition-delay: 140ms; }
    .navbar__nav.open .navbar__link:nth-child(4) { transition-delay: 180ms; }
    .navbar__nav.open .navbar__link:nth-child(5) { transition-delay: 220ms; }

    .navbar__link::after { display: none; }

    .navbar__cta {
      margin-top: 1.5rem;
      padding: 0.85rem 2rem;
      font-size: 0.9375rem;
      background: var(--wine);
      color: #fff;
      border-color: var(--wine);
      opacity: 0;
      transition: opacity 300ms var(--ease) 260ms;
    }

    .navbar__nav.open .navbar__cta { opacity: 1; }
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const hamburger = document.getElementById('navHamburger');
  const navMenu = document.getElementById('navMenu');

  if (navbar) {
    const onScroll = () => navbar.classList.toggle('scrolled', window.scrollY > 24);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  if (hamburger && navMenu) {
    const setOpen = (open: boolean) => {
      hamburger.setAttribute('aria-expanded', String(open));
      hamburger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      navMenu.classList.toggle('open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };

    hamburger.addEventListener('click', () => {
      setOpen(hamburger.getAttribute('aria-expanded') !== 'true');
    });

    navMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && hamburger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
      }
    });
  }
</script>
