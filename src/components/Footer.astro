---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.png';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Image src={logoImg} alt="Pétalos Mary" class="footer__logo" loading="lazy" />
        <p class="footer__tagline">
          Florería artesanal en San José Buenavista, Puebla. Arreglos hechos a mano
          para cumpleaños, bodas, graduaciones y fechas especiales.
        </p>
      </div>

      <nav class="footer__col" aria-label="Navegación del sitio">
        <h2 class="footer__col-title">Sitio</h2>
        <a href="#inicio">Inicio</a>
        <a href="#galeria">Galería</a>
        <a href="#catalogo">Qué hacemos</a>
        <a href="#proceso">Proceso</a>
        <a href="#preguntas">Preguntas</a>
      </nav>

      <div class="footer__col">
        <h2 class="footer__col-title">Horario</h2>
        <p>Lun a sáb · 9:00 – 19:00</p>
        <p>Domingo · 10:00 – 15:00</p>
        <p class="footer__note">Temporada alta: horario ampliado</p>
      </div>

      <div class="footer__col">
        <h2 class="footer__col-title">Contacto</h2>
        <a href="tel:+522371113802">+52 237 111 3802</a>
        <a
          href="https://wa.me/5212371113802?text=Hola%2C%20quiero%20cotizar%20un%20arreglo%20floral"
          target="_blank"
          rel="noreferrer"
        >
          WhatsApp
        </a>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} Pétalos Mary</p>
      <p>
        Sitio por <a href="https://ngicode.com" target="_blank" rel="noopener noreferrer">ngicode</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.875rem;
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .footer__logo {
    height: 40px;
    width: auto;
    margin-bottom: 1.25rem;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .footer__tagline {
    max-width: 32ch;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .footer__col-title {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--brass) 78%, #fff);
    margin-bottom: 0.35rem;
  }

  .footer__col a {
    transition: color 200ms var(--ease);
  }

  .footer__col a:hover { color: #fff; }

  .footer__note {
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.8125rem;
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.35);
  }

  .footer__bottom a {
    color: rgba(255, 255, 255, 0.55);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    transition: color 200ms var(--ease);
  }

  .footer__bottom a:hover { color: #fff; }

  @media (max-width: 860px) {
    .footer__top { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer__brand { grid-column: 1 / -1; }
  }

  @media (max-width: 480px) {
    .footer__top { grid-template-columns: 1fr; }
    .footer__bottom { justify-content: center; text-align: center; }
  }
</style>
