---
const steps = [
  {
    num: '1',
    title: 'Escríbenos',
    desc: 'Cuéntanos la ocasión, la fecha de entrega y tu presupuesto. Si tienes una foto de referencia, mándala.',
  },
  {
    num: '2',
    title: 'Definimos el arreglo',
    desc: 'Te proponemos flores, colores y presentación. Ajustamos hasta que quede como lo imaginas y confirmamos el precio.',
  },
  {
    num: '3',
    title: 'Armamos y entregamos',
    desc: 'El arreglo se arma el mismo día de la entrega para que llegue fresco, y te avisamos cuando va en camino.',
  },
];
---

<section class="process section" id="proceso" aria-labelledby="process-title">
  <div class="container">
    <header class="process__header reveal">
      <span class="section-label">Cómo se pide</span>
      <h2 class="section-title" id="process-title">Tres mensajes y <em>listo</em></h2>
      <p class="section-body process__intro">
        Sin formularios ni carrito. Todo se resuelve en la misma conversación de WhatsApp.
      </p>
    </header>

    <ol class="process__steps">
      {steps.map((step, idx) => (
        <li class="process__step reveal" style={`transition-delay: ${idx * 110}ms;`}>
          <span class="process__num" aria-hidden="true">{step.num}</span>
          <h3 class="process__name">{step.title}</h3>
          <p class="process__desc">{step.desc}</p>
        </li>
      ))}
    </ol>

    <div class="process__cta reveal">
      <a
        href="https://wa.me/5212371113802?text=Hola%2C%20quiero%20cotizar%20un%20arreglo%20floral"
        class="btn btn-primary"
        target="_blank"
        rel="noreferrer"
      >
        Empezar la conversación
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <p class="process__note">Respondemos en horario de tienda: lun a sáb, 9am – 7pm.</p>
    </div>
  </div>
</section>

<style>
  .process { background: var(--surface); }

  .process__header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
  }

  .process__header .section-label { justify-content: center; }
  .process__intro { margin: 1rem auto 0; }

  .process__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    max-width: 60rem;
    margin-inline: auto;
    list-style: none;
    counter-reset: none;
  }

  .process__step {
    padding: 0 clamp(1rem, 3vw, 2.25rem);
    border-left: 1px solid var(--line);
  }

  .process__step:last-child { border-right: 1px solid var(--line); }

  .process__num {
    display: block;
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 300;
    line-height: 1;
    color: var(--brass);
    margin-bottom: 1.25rem;
  }

  .process__name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin-bottom: 0.6rem;
  }

  .process__desc {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .process__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .process__note {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .process__steps { grid-template-columns: 1fr; max-width: 26rem; }

    .process__step {
      padding: 1.5rem 0 1.5rem 1.5rem;
      border-left: 1px solid var(--line);
    }

    .process__step:last-child { border-right: none; }

    .process__num { font-size: 2rem; margin-bottom: 0.75rem; }
  }
</style>
