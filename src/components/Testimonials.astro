---
const reviews = [
  {
    quote:
      'Pedí un ramo para el cumpleaños de mi mamá y llegó con una presentación preciosa. La atención fue rápida y muy amable desde el primer mensaje.',
    author: 'Daniela R.',
    meta: 'Ramo de cumpleaños',
  },
  {
    quote:
      'Nos ayudaron con centros de mesa para la boda de mi hermana. Todo se vio delicado, bien combinado, y los arreglos llegaron frescos y a tiempo.',
    author: 'María de los Ángeles P.',
    meta: 'Decoración de boda',
  },
  {
    quote:
      'Entendieron exactamente el estilo que quería. Fue fácil cotizar todo por WhatsApp y el resultado fue mejor de lo que esperaba.',
    author: 'Carlos M.',
    meta: 'Ramo de dinero',
  },
];
---

<section class="testimonials section" id="testimonios" aria-labelledby="testimonials-title">
  <div class="container">
    <header class="testimonials__header reveal">
      <span class="section-label">Lo que dicen</span>
      <h2 class="section-title" id="testimonials-title">Pedidos que <em>llegaron bien</em></h2>
    </header>

    <ul class="testimonials__grid" role="list">
      {reviews.map((review, index) => (
        <li class="testimonials__card reveal" style={`transition-delay: ${index * 110}ms;`}>
          <blockquote class="testimonials__quote">{review.quote}</blockquote>
          <footer class="testimonials__foot">
            <cite class="testimonials__author">{review.author}</cite>
            <span class="testimonials__meta">{review.meta}</span>
          </footer>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .testimonials {
    background: var(--cream);
    content-visibility: auto;
    contain-intrinsic-size: 1px 700px;
  }

  .testimonials__header {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    list-style: none;
    border-top: 1px solid var(--line);
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .testimonials__card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* La comilla volada es el único adorno tipográfico de la sección */
  .testimonials__quote {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.55;
    color: var(--ink);
    flex: 1;
    text-wrap: pretty;
  }

  .testimonials__quote::before {
    content: '“';
    position: absolute;
    top: -0.4em;
    left: -0.45em;
    font-size: 3rem;
    line-height: 1;
    color: var(--wine);
    opacity: 0.22;
  }

  .testimonials__foot {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .testimonials__author {
    font-size: 0.875rem;
    font-weight: 600;
    font-style: normal;
    color: var(--ink);
  }

  .testimonials__meta {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brass);
  }

  @media (max-width: 860px) {
    .testimonials__grid { grid-template-columns: 1fr; gap: 2rem; }
    .testimonials__quote { padding-left: 0.5rem; }
  }
</style>
