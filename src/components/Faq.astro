---
const faqs = [
  {
    q: '¿Con cuánta anticipación debo pedir?',
    a: 'Para fechas especiales como 10 de mayo, 14 de febrero o graduaciones, aparta con 2 a 5 días. Para pedidos urgentes escríbenos y revisamos disponibilidad del día.',
  },
  {
    q: '¿Hacen entregas fuera de San José Buenavista?',
    a: 'Sí. Cubrimos San Marcos Tlacoyalco y comunidades cercanas por acuerdo previo. Confírmanos la dirección al cotizar para checar el costo de entrega.',
  },
  {
    q: '¿Puedo pedir algo personalizado con un presupuesto fijo?',
    a: 'Claro. Compártenos tu rango y te proponemos opciones viables sin sacrificar la presentación: cambiamos tipo de flor, tamaño o envoltura para que entre en el presupuesto.',
  },
  {
    q: '¿Qué métodos de pago aceptan?',
    a: 'Transferencia o efectivo, según el tipo de entrega. En pedidos grandes o de temporada alta pedimos un anticipo para apartar la fecha.',
  },
  {
    q: '¿Cuánto duran los arreglos?',
    a: 'Las flores naturales duran entre 5 y 8 días con agua y sombra. Las rosas de listón, los chocolates y los ramos de dinero se conservan indefinidamente.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<section class="faq section" id="preguntas" aria-labelledby="faq-title">
  <div class="container faq__inner">
    <header class="faq__header reveal">
      <span class="section-label">Preguntas frecuentes</span>
      <h2 class="section-title" id="faq-title">Antes de <em>escribirnos</em></h2>
    </header>

    <div class="faq__list">
      {faqs.map((item, index) => (
        <details class="faq__item reveal" style={`transition-delay: ${index * 60}ms;`}>
          <summary class="faq__question">
            <span>{item.q}</span>
            <span class="faq__sign" aria-hidden="true"></span>
          </summary>
          <p class="faq__answer">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

<style>
  .faq {
    background: var(--surface);
    content-visibility: auto;
    contain-intrinsic-size: 1px 720px;
  }

  .faq__inner { max-width: 46rem; }

  .faq__header { margin-bottom: clamp(2rem, 4vw, 2.75rem); }

  .faq__list { border-top: 1px solid var(--line); }

  .faq__item { border-bottom: 1px solid var(--line); }

  .faq__question {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    transition: color 220ms var(--ease);
  }

  .faq__question::-webkit-details-marker { display: none; }
  .faq__question:hover { color: var(--wine); }

  /* Signo +/− dibujado con dos filetes, sin icono externo */
  .faq__sign {
    position: relative;
    flex-shrink: 0;
    width: 0.875rem;
    height: 0.875rem;
  }

  .faq__sign::before,
  .faq__sign::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--wine);
    transition: transform 320ms var(--ease);
  }

  .faq__sign::after { transform: rotate(90deg); }

  .faq__item[open] .faq__sign::after { transform: rotate(0deg); }

  .faq__answer {
    padding: 0 3rem 1.5rem 0;
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.75;
    text-wrap: pretty;
    animation: faqReveal 300ms var(--ease);
  }

  @keyframes faqReveal {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: none; }
  }

  @media (max-width: 560px) {
    .faq__answer { padding-right: 0; }
  }
</style>
