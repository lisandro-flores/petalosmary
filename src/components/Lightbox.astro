---
// Visor de imagen único y reutilizable.
// Cualquier botón con [data-lightbox-item] lo abre; los botones que comparten
// el mismo [data-lightbox-group] se navegan entre sí con las flechas.
const WA_BASE = 'https://wa.me/5212371113802?text=';
---

<div
  class="lightbox"
  id="lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Vista ampliada del arreglo"
  hidden
  data-wa-base={WA_BASE}
>
  <div class="lightbox__backdrop" data-lightbox-close></div>

  <div class="lightbox__panel">
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="Cerrar vista">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>

    <div class="lightbox__stage">
      <p class="lightbox__loader" id="lightboxLoader">Cargando…</p>
      <img id="lightboxImg" class="lightbox__img" src="" alt="" />
    </div>

    <div class="lightbox__bar">
      <div class="lightbox__nav">
        <button type="button" class="lightbox__arrow" id="lightboxPrev" aria-label="Arreglo anterior">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <span class="lightbox__counter" id="lightboxCounter" aria-live="polite"></span>
        <button type="button" class="lightbox__arrow" id="lightboxNext" aria-label="Arreglo siguiente">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>

      <a id="lightboxCta" class="lightbox__cta" href="" target="_blank" rel="noreferrer">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Cotizar este arreglo
      </a>
    </div>
  </div>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 2.5rem);
  }

  .lightbox[hidden] { display: none; }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--wine-deep) 62%, #000);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: lbFade 260ms var(--ease);
    border: none;
  }

  .lightbox__panel {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 30rem;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    animation: lbRise 320ms var(--ease);
  }

  .lightbox__close {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    z-index: 3;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    backdrop-filter: blur(8px);
    color: var(--ink);
    cursor: pointer;
    transition: background var(--transition);
  }

  .lightbox__close:hover { background: var(--surface); }

  .lightbox__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 14rem;
    background: var(--wine-soft);
    flex: 1;
    overflow: hidden;
  }

  .lightbox__loader {
    position: absolute;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .lightbox__img {
    position: relative;
    z-index: 2;
    width: 100%;
    max-height: 62vh;
    object-fit: contain;
    opacity: 0;
    transition: opacity 260ms var(--ease);
  }

  .lightbox__img.is-loaded { opacity: 1; }

  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.125rem;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
  }

  .lightbox__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lightbox__arrow {
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: none;
    color: var(--ink);
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition);
  }

  .lightbox__arrow:hover {
    background: var(--wine-soft);
    border-color: color-mix(in srgb, var(--wine) 30%, transparent);
  }

  .lightbox__counter {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    min-width: 3.5rem;
    text-align: center;
  }

  .lightbox__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    background: var(--wine);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    transition: background var(--transition);
  }

  .lightbox__cta:hover { background: var(--wine-deep); }

  @keyframes lbFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lbRise {
    from { opacity: 0; transform: translateY(16px) scale(0.985); }
    to   { opacity: 1; transform: none; }
  }

  @media (max-width: 480px) {
    .lightbox__bar { justify-content: center; }
    .lightbox__cta { flex: 1; justify-content: center; }
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox');
  const img = document.getElementById('lightboxImg') as HTMLImageElement | null;
  const loader = document.getElementById('lightboxLoader');
  const counter = document.getElementById('lightboxCounter');
  const cta = document.getElementById('lightboxCta') as HTMLAnchorElement | null;
  const prevBtn = document.getElementById('lightboxPrev');
  const nextBtn = document.getElementById('lightboxNext');

  if (lightbox && img && cta) {
    const waBase = lightbox.dataset.waBase ?? 'https://wa.me/5212371113802?text=';
    let group: HTMLElement[] = [];
    let index = 0;
    let lastFocused: HTMLElement | null = null;

    const render = () => {
      const item = group[index];
      if (!item) return;
      const src = item.dataset.src ?? '';
      const alt = item.dataset.alt ?? 'Arreglo floral de Pétalos Mary';

      img.classList.remove('is-loaded');
      if (loader) loader.hidden = false;
      img.onload = () => {
        img.classList.add('is-loaded');
        if (loader) loader.hidden = true;
      };
      img.src = src;
      img.alt = alt;

      const absolute = src.startsWith('http') ? src : window.location.origin + (src.startsWith('/') ? src : `/${src}`);
      cta.href = waBase + encodeURIComponent(`Hola, me interesa este arreglo.\n\nReferencia: ${absolute}`);

      if (counter) counter.textContent = `${index + 1} / ${group.length}`;
      const single = group.length < 2;
      prevBtn?.toggleAttribute('hidden', single);
      nextBtn?.toggleAttribute('hidden', single);
      if (counter) counter.hidden = single;
    };

    const open = (trigger: HTMLElement) => {
      const name = trigger.dataset.lightboxGroup ?? 'default';
      group = Array.from(
        document.querySelectorAll<HTMLElement>(`[data-lightbox-item][data-lightbox-group="${name}"]`)
      );
      index = Math.max(0, group.indexOf(trigger));
      lastFocused = trigger;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      render();
      (lightbox.querySelector('.lightbox__close') as HTMLElement | null)?.focus();
    };

    const close = () => {
      lightbox.hidden = true;
      if (!document.querySelector('.gallery-sheet:not([hidden])')) {
        document.body.style.overflow = '';
      }
      lastFocused?.focus();
    };

    const step = (delta: number) => {
      if (group.length < 2) return;
      index = (index + delta + group.length) % group.length;
      render();
    };

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-lightbox-item]');
      if (trigger) open(trigger);
    });

    lightbox.querySelectorAll('[data-lightbox-close]').forEach((el) => {
      el.addEventListener('click', close);
    });

    prevBtn?.addEventListener('click', () => step(-1));
    nextBtn?.addEventListener('click', () => step(1));

    document.addEventListener('keydown', (event) => {
      if (lightbox.hidden) return;
      if (event.key === 'Escape') { event.stopPropagation(); close(); }
      if (event.key === 'ArrowLeft') step(-1);
      if (event.key === 'ArrowRight') step(1);
    });
  }
</script>
