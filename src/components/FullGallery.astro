---
import { Image, getImage } from 'astro:assets';
import { FALLBACK_GALLERY, FALLBACK_SPRING } from '../lib/fallback';

const allImages = [
  ...FALLBACK_GALLERY,
  ...FALLBACK_SPRING.map((img) => ({ ...img, category: 'especiales' as const })),
];

const optimizedImages = await Promise.all(
  allImages.map(async (img) => {
    const optImg = await getImage({ src: img.src, format: 'webp', width: 1200, quality: 80 });
    return { ...img, optimizedSrc: optImg.src };
  })
);
---

<div class="gallery-sheet" id="galleryModal" role="dialog" aria-modal="true" aria-labelledby="gallerySheetTitle" hidden>
  <div class="gallery-sheet__backdrop" id="closeGallery"></div>

  <div class="gallery-sheet__panel">
    <header class="gallery-sheet__header">
      <div>
        <span class="section-label">Archivo completo</span>
        <h2 class="gallery-sheet__title" id="gallerySheetTitle">
          {optimizedImages.length} arreglos entregados
        </h2>
      </div>
      <button type="button" class="gallery-sheet__close" id="closeGalleryBtn" aria-label="Cerrar galería">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </header>

    <div class="gallery-sheet__scroll">
      <ul class="gallery-sheet__grid" role="list">
        {optimizedImages.map((img) => (
          <li>
            <button
              type="button"
              class="gallery-sheet__item"
              data-lightbox-item
              data-lightbox-group="all"
              data-src={img.optimizedSrc}
              data-alt={`${img.alt} de Pétalos Mary`}
              aria-label={`Ampliar ${img.alt}`}
            >
              <Image
                src={img.src}
                alt={`${img.alt} de Pétalos Mary`}
                width={420}
                height={525}
                quality={72}
                loading="lazy"
                decoding="async"
              />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .gallery-sheet {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.75rem, 3vw, 2.5rem);
  }

  .gallery-sheet[hidden] { display: none; }

  .gallery-sheet__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--wine-deep) 55%, #000);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: sheetFade 260ms var(--ease);
  }

  .gallery-sheet__panel {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--max-w);
    max-height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--cream);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    animation: sheetRise 340ms var(--ease);
  }

  .gallery-sheet__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .gallery-sheet__header .section-label { margin-bottom: 0.5rem; }

  .gallery-sheet__title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .gallery-sheet__close {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  .gallery-sheet__close:hover {
    background: var(--wine);
    border-color: var(--wine);
    color: #fff;
  }

  .gallery-sheet__scroll {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(1rem, 3vw, 2rem) clamp(1rem, 3vw, 2.25rem) clamp(1.5rem, 4vw, 2.75rem);
  }

  .gallery-sheet__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(11rem, 100%), 1fr));
    gap: clamp(0.5rem, 1.5vw, 1rem);
    list-style: none;
  }

  .gallery-sheet__item {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--wine-soft);
    cursor: pointer;
    transition: box-shadow var(--transition);
  }

  .gallery-sheet__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease);
  }

  .gallery-sheet__item:hover { box-shadow: var(--shadow-md); }
  .gallery-sheet__item:hover img { transform: scale(1.06); }

  @keyframes sheetFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes sheetRise {
    from { opacity: 0; transform: translateY(20px) scale(0.99); }
    to   { opacity: 1; transform: none; }
  }
</style>

<script>
  const sheet = document.getElementById('galleryModal');
  const closeBtn = document.getElementById('closeGalleryBtn');
  const backdrop = document.getElementById('closeGallery');
  let opener: HTMLElement | null = null;

  const openSheet = (trigger: HTMLElement) => {
    if (!sheet) return;
    opener = trigger;
    sheet.hidden = false;
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  };

  const closeSheet = () => {
    if (!sheet || sheet.hidden) return;
    sheet.hidden = true;
    document.body.style.overflow = '';
    opener?.focus();
  };

  document.querySelectorAll<HTMLElement>('.open-gallery-btn').forEach((btn) => {
    btn.addEventListener('click', () => openSheet(btn));
  });

  closeBtn?.addEventListener('click', closeSheet);
  backdrop?.addEventListener('click', closeSheet);

  document.addEventListener('keydown', (event) => {
    const lightboxOpen = !document.getElementById('lightbox')?.hasAttribute('hidden');
    if (event.key === 'Escape' && !lightboxOpen) closeSheet();
  });
</script>
