---
// Mensaje breve según la época del año para destacar promociones puntuales.
const now = new Date();
const month = now.getMonth() + 1; // 1-12
const day = now.getDate();

let message = '';

// San Valentín (14 feb) — desde el 25 de enero
if ((month === 1 && day >= 25) || (month === 2 && day <= 14)) {
  message = 'San Valentín: aparta tu ramo con anticipación, los cupos del 14 se llenan rápido.';
}

// Día de las Madres (10 mayo) — desde el 22 de marzo
if ((month === 3 && day >= 22) || month === 4 || (month === 5 && day <= 10)) {
  message = 'Día de las Madres: agenda tu arreglo con entrega el 10 de mayo.';
}

// Día del Padre (tercer domingo de junio)
if (month === 6 && day <= 21) {
  message = 'Preventa Día del Padre: ramos de dinero y chocolates para papá.';
}

// Graduaciones (junio-agosto)
if ((month === 6 && day > 21) || month === 7 || month === 8) {
  message = 'Temporada de graduaciones: ramos con chocolates y bandas personalizadas.';
}

// Día de Muertos — desde el 20 de octubre
if ((month === 10 && day >= 20) || (month === 11 && day <= 2)) {
  message = 'Día de Muertos: arreglos con cempasúchil y flor de temporada.';
}

// Navidad
if (month === 12) {
  message = 'Navidad: centros de mesa y arreglos navideños por pedido.';
}
---

{message && (
  <div class="banner" id="seasonalBanner">
    <div class="container banner__inner">
      <p class="banner__text">{message}</p>
      <a
        href="https://wa.me/5212371113802?text=Hola%2C%20vi%20la%20promoción%20de%20temporada%20y%20quiero%20cotizar"
        class="banner__cta"
        target="_blank"
        rel="noreferrer"
      >
        Cotizar
      </a>
      <button class="banner__close" id="closeBanner" aria-label="Cerrar aviso de temporada">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </div>
)}

<style>
  .banner {
    background: var(--wine);
    color: #fff;
    font-size: 0.8125rem;
    overflow: hidden;
    transition: max-height 400ms var(--ease), opacity 300ms var(--ease);
    max-height: 6rem;
  }

  .banner.is-hidden {
    max-height: 0;
    opacity: 0;
  }

  .banner__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-block: 0.6rem;
  }

  .banner__text {
    letter-spacing: 0.01em;
    text-align: center;
  }

  .banner__cta {
    flex-shrink: 0;
    padding: 0.2rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 220ms var(--ease);
  }

  .banner__cta:hover { background: rgba(255, 255, 255, 0.16); }

  .banner__close {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-left: auto;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: color 220ms var(--ease);
  }

  .banner__close:hover { color: #fff; }

  @media (max-width: 640px) {
    .banner__inner { gap: 0.75rem; }
    .banner__cta { display: none; }
    .banner__text { text-align: left; font-size: 0.75rem; }
  }
</style>

<script>
  const banner = document.getElementById('seasonalBanner');
  const closeBanner = document.getElementById('closeBanner');
  const KEY = 'pm-banner-dismissed';

  if (banner) {
    // Si ya lo cerraron en esta sesión, no volver a mostrarlo.
    if (sessionStorage.getItem(KEY) === '1') {
      banner.remove();
    } else {
      closeBanner?.addEventListener('click', () => {
        banner.classList.add('is-hidden');
        sessionStorage.setItem(KEY, '1');
      });
    }
  }
</script>
