---
import { Image } from 'astro:assets';
import heroImg from '../assets/images/IMG-20260226-WA0033.jpg';

const WA = 'https://wa.me/5212371113802?text=Hola%2C%20quiero%20cotizar%20un%20arreglo%20floral';
---

<section class="hero" id="inicio" aria-label="Bienvenida — Pétalos Mary">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">
        <span class="hero__dot" aria-hidden="true"></span>
        Florería artesanal · San José Buenavista, Puebla
      </p>

      <h1 class="hero__title">
        Arreglos hechos a mano<br />
        para los días que <em>no se olvidan</em>
      </h1>

      <p class="hero__subtitle">
        Flores naturales, rosas de listón, ramos con chocolates y detalles de dinero.
        Cada pedido se arma a mano y se cotiza contigo por WhatsApp.
      </p>

      <div class="hero__actions">
        <a href={WA} class="btn btn-primary" target="_blank" rel="noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Cotizar por WhatsApp
        </a>
        <a href="#galeria" class="hero__secondary">
          Ver los trabajos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <dl class="hero__facts">
        <div class="hero__fact">
          <dt>Entregas</dt>
          <dd>San José Buenavista y San Marcos Tlacoyalco</dd>
        </div>
        <div class="hero__fact">
          <dt>Anticipación</dt>
          <dd>2 a 5 días para fechas especiales</dd>
        </div>
        <div class="hero__fact">
          <dt>Cotización</dt>
          <dd>Por WhatsApp, con fotos de referencia</dd>
        </div>
      </dl>
    </div>

    <figure class="hero__figure">
      <div class="hero__arch">
        <Image
          src={heroImg}
          alt="Ramo artesanal de rosas de listón en tonos rosa y rojo, elaborado por Pétalos Mary"
          width={760}
          height={950}
          quality={82}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption class="hero__caption">
        Ramo de 24 rosas de listón · pedido de mayo
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(3.5rem, 8vw, 7rem);
    background:
      linear-gradient(180deg, var(--surface) 0%, var(--cream) 70%);
    position: relative;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }

  .hero__content { max-width: 40rem; }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.75rem;
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brass);
    flex-shrink: 0;
  }

  .hero__title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(2.4rem, 5.4vw, 4.1rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }

  .hero__title em {
    font-style: italic;
    color: var(--wine);
  }

  .hero__subtitle {
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    color: var(--muted);
    line-height: 1.7;
    max-width: 34rem;
    margin-bottom: 2.25rem;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .hero__secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    padding-bottom: 2px;
    border-bottom: 1px solid var(--line);
    transition: color var(--transition), border-color var(--transition);
  }

  .hero__secondary:hover {
    color: var(--wine);
    border-bottom-color: var(--wine);
  }

  /* Ficha de datos en lugar de "badges" decorativos */
  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .hero__fact dt {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 0.4rem;
  }

  .hero__fact dd {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.5;
  }

  /* ── Elemento firma: el arco (ventana de florería / cono de envoltura) ── */
  .hero__figure {
    margin: 0;
    position: relative;
  }

  .hero__arch {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 50vw 50vw var(--radius-lg) var(--radius-lg);
    overflow: hidden;
    background: var(--wine-soft);
    box-shadow: var(--shadow-lg);
  }

  /* Filete interior fino que refuerza la forma del arco */
  .hero__arch::after {
    content: '';
    position: absolute;
    inset: 0.625rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50vw 50vw calc(var(--radius-lg) - 4px) calc(var(--radius-lg) - 4px);
    pointer-events: none;
  }

  .hero__arch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    transition: transform 900ms var(--ease);
  }

  .hero__figure:hover .hero__arch img { transform: scale(1.03); }

  .hero__caption {
    margin-top: 1.125rem;
    font-size: 0.8125rem;
    color: var(--muted);
    text-align: center;
    letter-spacing: 0.01em;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero__content { max-width: 100%; order: 2; }
    .hero__figure { order: 1; max-width: 26rem; margin-inline: auto; }
    .hero__facts { grid-template-columns: 1fr; gap: 1.125rem; }
  }

  @media (max-width: 560px) {
    .hero__actions { gap: 1.25rem; }
    .hero__actions .btn { width: 100%; }
  }
</style>
