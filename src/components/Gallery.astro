---
import { Image, getImage } from 'astro:assets';
import { FALLBACK_GALLERY, FALLBACK_SPRING } from '../lib/fallback';
import type { GalleryItem } from '../lib/fallback';

interface Props { items?: GalleryItem[]; }
const { items = FALLBACK_GALLERY } = Astro.props;

// Total real disponible en el visor completo (galería + serie amarillas).
const totalPhotos = items.length + FALLBACK_SPRING.length;

const CATEGORY_LABEL: Record<GalleryItem['category'], string> = {
  ramos: 'Ramos',
  bodas: 'Bodas',
  eventos: 'Eventos',
  especiales: 'Detalles especiales',
};

// Una muestra representativa: los primeros de cada categoría.
const order: GalleryItem['category'][] = ['ramos', 'bodas', 'eventos', 'especiales'];
const picked: GalleryItem[] = [];
for (let round = 0; picked.length < 6 && round < 3; round++) {
  for (const category of order) {
    const next = items.filter((item) => item.category === category)[round];
    if (next && picked.length < 6) picked.push(next);
  }
}
const displayItems = picked.length ? picked : items.slice(0, 6);

const optimizedItems = await Promise.all(
  displayItems.map(async (item) => {
    const optImg = await getImage({ src: item.src, format: 'webp', width: 1200, quality: 80 });
    return { ...item, optimizedSrc: optImg.src };
  })
);
---

<section class="gallery section" id="galeria" aria-labelledby="gallery-title">
  <div class="container">
    <header class="gallery__header reveal">
      <div>
        <span class="section-label">Trabajos entregados</span>
        <h2 class="section-title" id="gallery-title">Cada arreglo, <em>una historia</em></h2>
      </div>
      <p class="section-body gallery__intro">
        Fotos reales de pedidos que salieron del taller. Toca cualquiera para verlo en
        grande y cotizar uno parecido.
      </p>
    </header>

    <ul class="gallery__grid" role="list">
      {optimizedItems.map((item, idx) => (
        <li class="gallery__cell reveal" style={`transition-delay: ${Math.min(idx, 4) * 80}ms;`}>
          <button
            type="button"
            class="gallery__item"
            data-lightbox-item
            data-lightbox-group="preview"
            data-src={item.optimizedSrc}
            data-alt={`${CATEGORY_LABEL[item.category]} — ${item.alt} de Pétalos Mary`}
            aria-label={`Ampliar: ${CATEGORY_LABEL[item.category]}`}
          >
            <Image
              src={item.src}
              alt={`${CATEGORY_LABEL[item.category]} elaborado por Pétalos Mary`}
              width={620}
              height={775}
              quality={78}
              loading={idx < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <span class="gallery__tag">{CATEGORY_LABEL[item.category]}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="gallery__more reveal">
      <button type="button" class="btn btn-outline open-gallery-btn">
        Ver las {totalPhotos} fotos
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .gallery { background: var(--surface); }

  .gallery__header {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .gallery__intro { margin: 0; }

  /* Retícula escalonada: las celdas pares caen un poco para dar ritmo editorial */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
    list-style: none;
  }

  .gallery__cell { min-width: 0; }

  @media (min-width: 900px) {
    .gallery__cell:nth-child(even) { transform: translateY(2.25rem); }
    .gallery__cell:nth-child(even).reveal { transform: translateY(calc(2.25rem + 18px)); }
    .gallery__cell:nth-child(even).reveal.active { transform: translateY(2.25rem); }
    .gallery__grid { padding-bottom: 2.25rem; }
  }

  .gallery__item {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--wine-soft);
    cursor: pointer;
    transition: box-shadow var(--transition);
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease), filter var(--transition);
  }

  .gallery__item:hover { box-shadow: var(--shadow-md); }
  .gallery__item:hover img { transform: scale(1.05); }

  /* Etiqueta de categoría: informativa, no decorativa */
  .gallery__tag {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wine);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--transition), transform var(--transition);
  }

  .gallery__item:hover .gallery__tag,
  .gallery__item:focus-visible .gallery__tag {
    opacity: 1;
    transform: none;
  }

  .gallery__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  @media (max-width: 899px) {
    .gallery__header { grid-template-columns: 1fr; align-items: start; }
    .gallery__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 480px) {
    .gallery__tag { opacity: 1; transform: none; font-size: 0.625rem; }
  }
</style>
